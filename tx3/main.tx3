// SundaeSwap v3 Tx3 draft
//
// This is a first MVP-oriented draft focused on user-facing order lifecycle txs.
// It is intentionally narrow and should be treated as a starting point, not a final
// production-ready protocol description.
//
// Current draft limitations / TODOs:
// - models owner as a simple Signature multisig case only
// - models destination as Fixed + NoDatum only
// - fixes extension to empty bytes
// - does not yet model strategy, donation, record, scoop, pool, or admin flows
//
// Source of truth in this repo:
// - lib/types/order.ak
// - validators/order.ak
// - lib/types/pool.ak
// - validators/pool.ak
// - lib/types/settings.ak
// - validators/settings.ak

// --- Environment ---

env {
    // UTxO carrying the Sundae order reference script.
    order_script_ref: UtxoRef,

    // Collateral floor for script-spending txs such as cancel.
    min_collateral_ada: Int,
}

// --- Parties ---

party User;
party OrderScript;

// --- Types ---

// Draft stand-in for Aiken's Option<ByteArray>.
// In MVP txs below we only use None.
type MaybeBytes {
    Some {
        value: Bytes,
    },
    None,
}

// Draft subset-compatible model of Sundae multisig.
// MVP txs below only use Signature.
type MultisigScript {
    Signature {
        key_hash: Bytes,
    },
    AllOf {
        scripts: List<MultisigScript>,
    },
    AnyOf {
        scripts: List<MultisigScript>,
    },
    AtLeast {
        required: Int,
        scripts: List<MultisigScript>,
    },
    Before {
        time: Int,
    },
    After {
        time: Int,
    },
    Script {
        script_hash: Bytes,
    },
}

// Draft subset-compatible model of cardano/transaction Datum.
// MVP txs below only use NoDatum.
type TxDatum {
    NoDatum,
    DatumHash {
        hash: Bytes,
    },
    InlineDatum {
        datum: Bytes,
    },
}

// Draft subset of Sundae destination handling.
type Destination {
    Fixed {
        address: Address,
        datum: TxDatum,
    },
    Self,
}

// MVP subset of Sundae order variants.
type Order {
    Swap {
        offer: AnyAsset,
        min_received: AnyAsset,
    },
    Deposit {
        assets: List<AnyAsset>,
    },
    Withdrawal {
        amount: AnyAsset,
    },
}

// MVP-compatible order datum.
type OrderDatum {
    pool_ident: MaybeBytes,
    owner: MultisigScript,
    max_protocol_fee: Int,
    destination: Destination,
    details: Order,
    extension: Bytes,
}

type OrderRedeemer {
    Scoop,
    Cancel,
}

// --- Transactions ---

/// Post a swap order to the Sundae order script.
///
/// Notes:
/// - `order_ada` should cover the order's non-offer ADA, including min-UTxO needs
///   and enough room for `max_protocol_fee`.
/// - For ADA offers, pass empty policy/name and the amount in `offer_amount`.
tx submit_swap(
    owner_key_hash: Bytes,
    destination_address: Address,
    order_ada: Int,
    max_protocol_fee: Int,
    offer_policy: Bytes,
    offer_name: Bytes,
    offer_amount: Int,
    min_received_policy: Bytes,
    min_received_name: Bytes,
    min_received_amount: Int,
) {
    locals {
        owner_script: MultisigScript::Signature {
            key_hash: owner_key_hash,
        },

        destination: Destination::Fixed {
            address: destination_address,
            datum: TxDatum::NoDatum { },
        },

        offer_asset: AnyAsset(offer_policy, offer_name, offer_amount),
        offer_datum: [offer_policy, offer_name, offer_amount],

        min_received_datum: [min_received_policy, min_received_name, min_received_amount],
    }

    input source {
        from: User,
        min_amount: Ada(order_ada) + offer_asset + fees,
    }

    output order_utxo {
        to: OrderScript,
        amount: Ada(order_ada) + offer_asset,
        datum: OrderDatum {
            pool_ident: MaybeBytes::None { },
            owner: owner_script,
            max_protocol_fee: max_protocol_fee,
            destination: destination,
            details: Order::Swap {
                offer: offer_datum,
                min_received: min_received_datum,
            },
            extension: "",
        },
    }

    output? {
        to: User,
        amount: source - Ada(order_ada) - offer_asset - fees,
    }
}

/// Post a pool-targeted swap order to the Sundae order script.
///
/// This is the same as `submit_swap`, but constrains the order to a specific
/// Sundae pool identifier.
tx submit_swap_for_pool(
    pool_ident: Bytes,
    owner_key_hash: Bytes,
    destination_address: Address,
    order_ada: Int,
    max_protocol_fee: Int,
    offer_policy: Bytes,
    offer_name: Bytes,
    offer_amount: Int,
    min_received_policy: Bytes,
    min_received_name: Bytes,
    min_received_amount: Int,
) {
    locals {
        owner_script: MultisigScript::Signature {
            key_hash: owner_key_hash,
        },

        destination: Destination::Fixed {
            address: destination_address,
            datum: TxDatum::NoDatum { },
        },

        offer_asset: AnyAsset(offer_policy, offer_name, offer_amount),
        offer_datum: [offer_policy, offer_name, offer_amount],

        min_received_datum: [min_received_policy, min_received_name, min_received_amount],
    }

    input source {
        from: User,
        min_amount: Ada(order_ada) + offer_asset + fees,
    }

    output order_utxo {
        to: OrderScript,
        amount: Ada(order_ada) + offer_asset,
        datum: OrderDatum {
            pool_ident: MaybeBytes::Some {
                value: pool_ident,
            },
            owner: owner_script,
            max_protocol_fee: max_protocol_fee,
            destination: destination,
            details: Order::Swap {
                offer: offer_datum,
                min_received: min_received_datum,
            },
            extension: "",
        },
    }

    output? {
        to: User,
        amount: source - Ada(order_ada) - offer_asset - fees,
    }
}

/// Post a deposit order to the Sundae order script.
///
/// Notes:
/// - `order_ada` should cover the order's non-deposit ADA, including min-UTxO needs
///   and enough room for `max_protocol_fee`.
/// - If one side of the deposit is ADA, pass empty policy/name for that side.
tx submit_deposit(
    owner_key_hash: Bytes,
    destination_address: Address,
    order_ada: Int,
    max_protocol_fee: Int,
    asset_a_policy: Bytes,
    asset_a_name: Bytes,
    asset_a_amount: Int,
    asset_b_policy: Bytes,
    asset_b_name: Bytes,
    asset_b_amount: Int,
) {
    locals {
        owner_script: MultisigScript::Signature {
            key_hash: owner_key_hash,
        },

        destination: Destination::Fixed {
            address: destination_address,
            datum: TxDatum::NoDatum { },
        },

        deposit_a: AnyAsset(asset_a_policy, asset_a_name, asset_a_amount),
        deposit_a_datum: [asset_a_policy, asset_a_name, asset_a_amount],
        deposit_b: AnyAsset(asset_b_policy, asset_b_name, asset_b_amount),
        deposit_b_datum: [asset_b_policy, asset_b_name, asset_b_amount],
    }

    input source {
        from: User,
        min_amount: Ada(order_ada) + deposit_a + deposit_b + fees,
    }

    output order_utxo {
        to: OrderScript,
        amount: Ada(order_ada) + deposit_a + deposit_b,
        datum: OrderDatum {
            pool_ident: MaybeBytes::None { },
            owner: owner_script,
            max_protocol_fee: max_protocol_fee,
            destination: destination,
            details: Order::Deposit {
                assets: [deposit_a_datum, deposit_b_datum],
            },
            extension: "",
        },
    }

    output? {
        to: User,
        amount: source - Ada(order_ada) - deposit_a - deposit_b - fees,
    }
}

