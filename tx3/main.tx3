    locals {
        owner_script: MultisigScript::Signature {
            key_hash: owner_key_hash,
        },

        destination: Destination::Fixed {
            address: destination_address,
            datum: TxDatum::NoDatum { },
        },

        deposit_a: AnyAsset(asset_a_policy, asset_a_name, asset_a_amount),
        deposit_a_datum: [asset_a_policy, asset_a_name, asset_a_amount],
        deposit_b: AnyAsset(asset_b_policy, asset_b_name, asset_b_amount),
        deposit_b_datum: [asset_b_policy, asset_b_name, asset_b_amount],
    }

    input source {
        from: User,
        min_amount: Ada(order_ada) + deposit_a + deposit_b + fees,
    }

    output order_utxo {
        to: OrderScript,
        amount: Ada(order_ada) + deposit_a + deposit_b,
        datum: OrderDatum {
            pool_ident: MaybeBytes::Some {
                value: pool_ident,
            },
            owner: owner_script,
            max_protocol_fee: max_protocol_fee,
            destination: destination,
            details: Order::Deposit {
                assets: [deposit_a_datum, deposit_b_datum],
            },
            extension: "",
        },
    }

    output? {
        to: User,
        amount: source - Ada(order_ada) - deposit_a - deposit_b - fees,
    }
}

/// Post a withdrawal order to the Sundae order script.
///
/// Notes:
/// - `order_ada` should cover min-UTxO needs and enough room for `max_protocol_fee`.
/// - `lp_policy` / `lp_name` identify the LP asset being withdrawn.
tx submit_withdrawal(
    owner_key_hash: Bytes,
    destination_address: Address,
    order_ada: Int,
    max_protocol_fee: Int,
    lp_policy: Bytes,
    lp_name: Bytes,
    lp_amount: Int,
) {
    locals {
        owner_script: MultisigScript::Signature {
            key_hash: owner_key_hash,
        },

        destination: Destination::Fixed {
            address: destination_address,
            datum: TxDatum::NoDatum { },
        },

        lp_asset: AnyAsset(lp_policy, lp_name, lp_amount),
        lp_datum: [lp_policy, lp_name, lp_amount],
    }

    input source {
        from: User,
        min_amount: Ada(order_ada) + lp_asset + fees,
    }

    output order_utxo {
        to: OrderScript,
        amount: Ada(order_ada) + lp_asset,
        datum: OrderDatum {
            pool_ident: MaybeBytes::None { },
            owner: owner_script,
            max_protocol_fee: max_protocol_fee,
            destination: destination,
            details: Order::Withdrawal {
                amount: lp_datum,
            },
            extension: "",
        },
    }

    output? {
        to: User,
        amount: source - Ada(order_ada) - lp_asset - fees,
    }
}

/// Post a pool-targeted withdrawal order to the Sundae order script.
tx submit_withdrawal_for_pool(
    pool_ident: Bytes,
    owner_key_hash: Bytes,
    destination_address: Address,
    order_ada: Int,
    max_protocol_fee: Int,
    lp_policy: Bytes,
    lp_name: Bytes,
    lp_amount: Int,
) {
    locals {
        owner_script: MultisigScript::Signature {
            key_hash: owner_key_hash,
        },

        destination: Destination::Fixed {
            address: destination_address,
            datum: TxDatum::NoDatum { },
        },

        lp_asset: AnyAsset(lp_policy, lp_name, lp_amount),
        lp_datum: [lp_policy, lp_name, lp_amount],
    }

    input source {
        from: User,
        min_amount: Ada(order_ada) + lp_asset + fees,
    }

    output order_utxo {
        to: OrderScript,
        amount: Ada(order_ada) + lp_asset,
        datum: OrderDatum {
            pool_ident: MaybeBytes::Some {
                value: pool_ident,
            },
            owner: owner_script,
            max_protocol_fee: max_protocol_fee,
            destination: destination,
            details: Order::Withdrawal {
                amount: lp_datum,
            },
            extension: "",
        },
    }

    output? {
        to: User,
        amount: source - Ada(order_ada) - lp_asset - fees,
    }
}

/// Cancel an existing order.
///
/// Notes:
/// - This draft assumes the signer represented by `User` satisfies the order datum's
///   owner condition.
/// - The returned funds are paid back to `User`.
tx cancel_order(
    order_utxo: UtxoRef,
) {
    reference order_script_witness {
        ref: order_script_ref,
    }

    input fee_source {
        from: User,
        min_amount: fees,
    }

    input order_input {
        from: OrderScript,
        ref: order_utxo,
        redeemer: OrderRedeemer::Cancel { },
    }

    output {
        to: User,
        amount: fee_source + order_input - fees,
    }

    collateral {
        from: User,
        min_amount: Ada(min_collateral_ada),
    }

    signers {
        User,
    }
}

